{
  "name": "lodex",
  "displayName": "Lodex",
  "description": "A coding agent for VS Code with configurable model endpoints.",
  "version": "1.0.0",
  "publisher": "djblu",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onView:lodex.chat"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/djblu/Lodex.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package --allow-missing-repository",
    "build": "esbuild src/code-blocks.cjs --bundle --minify --format=iife --global-name=CodeBlocks --outfile=media/code-blocks.js && esbuild src/change-diff.cjs --bundle --minify --platform=node --format=cjs --outfile=change-diff.cjs && node scripts/copy-pdf-assets.cjs",
    "vscode:prepublish": "npm run build",
    "package:platform": "node scripts/package-platform.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "lodex.setApiKey",
        "title": "Lodex: Set API Key"
      },
      {
        "command": "lodex.addSelection",
        "title": "Lodex: Add Editor Selection"
      },
      {
        "command": "lodex.restart",
        "title": "Lodex: Restart Harness"
      },
      {
        "command": "lodex.connect",
        "title": "Lodex: Connect to Server"
      },
      {
        "command": "lodex.switchConnection",
        "title": "Lodex: Switch Saved Connection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lodex",
          "title": "Lodex",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "lodex": [
        {
          "type": "webview",
          "id": "lodex.chat",
          "name": "Lodex"
        }
      ]
    },
    "configuration": {
      "title": "Lodex Harness",
      "properties": {
        "lodex.sourcePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional runtime override. Leave all three runtime paths blank for automatic setup."
        },
        "lodex.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional runtime override. Leave all three runtime paths blank for automatic setup."
        },
        "lodex.harnessPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional runtime override. Leave all three runtime paths blank for automatic setup."
        },
        "lodex.baseURL": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Inference API URL, reached from the extension host."
        },
        "lodex.model": {
          "type": "string",
          "default": "",
          "scope": "machine"
        },
        "lodex.contextWindow": {
          "type": "number",
          "default": 262144,
          "minimum": 4096,
          "scope": "machine"
        },
        "lodex.thinking": {
          "type": "string",
          "enum": [
            "Off",
            "Low",
            "Medium",
            "High"
          ],
          "default": "Low"
        },
        "lodex.vision": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Enable image input only for a vision-capable model/API. Restart the harness after changing this setting."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "5.4.624"
  }
}
